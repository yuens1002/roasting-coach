{
  "name": "roasting-coach",
  "version": "0.1.5",
  "description": "Helps home roasters improve each roast from their logs and tasting notes",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "analyze": "tsx scripts/analyze-log.ts",
    "profiles": "tsx scripts/summarize-profiles.ts",
    "db:seed": "tsx scripts/gen-seed.ts",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "research": "tsx scripts/research.ts",
    "rules:steps": "tsx scripts/step-table.ts"
  },
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "pg": "^8.23.1"
  }
}

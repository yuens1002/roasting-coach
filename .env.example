# Copy to .env if your database isn't the docker-compose one. A git worktree with no .env of its
# own reads the one in the checkout it was made from.
DATABASE_URL=postgres://roast:roast@localhost:54320/roast_copilot

# Folder with your Kaffelogic .kpro and .klog files (any names, any depth). Profiles
# roasting-coach writes go to KAFFELOGIC_OUT_DIR, or to KAFFELOGIC_DIR/out when that is unset.
# KAFFELOGIC_DIR=E:\kaffelogic
# KAFFELOGIC_OUT_DIR=E:\kaffelogic\out
#
# With Kaffelogic Studio: the folder it syncs holds roast-logs-archive/ (the machine's logs) and
# roast-profiles/ (profiles Studio sends to the machine). Read from it and write there:
# KAFFELOGIC_DIR=<that folder>
# KAFFELOGIC_OUT_DIR=<that folder>/roast-profiles
